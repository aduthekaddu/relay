# Relay openbox theme: carbon and bone, with the orange signal reserved
# for the focused window's hairline and the active menu item.
# Palette mirrors docs/dev/DESIGN.md (carbon theme).

border.width: 1
padding.width: 6
padding.height: 4
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap.x: 0
menu.overlap.y: 0
menu.border.width: 1
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3

# Focused window
window.active.border.color: #ff5b1f
window.active.client.color: #111113
window.active.title.bg: flat solid
window.active.title.bg.color: #18181b
window.active.title.separator.color: #2a2a2f
window.active.label.bg: parentrelative
window.active.label.text.color: #ede9e0
window.active.label.text.font: shadow=n
window.active.handle.bg: flat solid
window.active.handle.bg.color: #18181b
window.active.grip.bg: flat solid
window.active.grip.bg.color: #18181b
window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #b3aea4
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #2a2a2f
window.active.button.hover.image.color: #ede9e0
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #ff5b1f
window.active.button.pressed.image.color: #0b0b0c
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #4b4840
window.active.button.toggled.bg: parentrelative
window.active.button.toggled.image.color: #ff7c4a

# Unfocused window
window.inactive.border.color: #2a2a2f
window.inactive.client.color: #111113
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #111113
window.inactive.title.separator.color: #202024
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #7c776f
window.inactive.label.text.font: shadow=n
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #111113
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #111113
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #57534d
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #202024
window.inactive.button.hover.image.color: #b3aea4
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #2a2a2f
window.inactive.button.pressed.image.color: #ede9e0
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #4b4840
window.inactive.button.toggled.bg: parentrelative
window.inactive.button.toggled.image.color: #a19d93

window.label.text.justify: left

# Menus
menu.border.color: #2a2a2f
menu.title.bg: flat solid
menu.title.bg.color: #111113
menu.title.text.color: #a19d93
menu.title.text.justify: left
menu.items.bg: flat solid
menu.items.bg.color: #18181b
menu.items.text.color: #ede9e0
menu.items.disabled.text.color: #57534d
menu.items.active.bg: flat solid
menu.items.active.bg.color: #ff5b1f
menu.items.active.text.color: #0b0b0c
menu.items.active.disabled.text.color: #4b4840
menu.separator.color: #2a2a2f

# On-screen display (window cycling, resize popups)
osd.border.width: 1
osd.border.color: #2a2a2f
osd.bg: flat solid
osd.bg.color: #18181b
osd.label.bg: parentrelative
osd.label.text.color: #ede9e0
osd.hilight.bg: flat solid
osd.hilight.bg.color: #ff5b1f
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #2a2a2f
osd.button.unpressed.bg: flat solid
osd.button.unpressed.bg.color: #18181b
osd.button.unpressed.text.color: #ede9e0
osd.button.focused.bg: flat solid
osd.button.focused.bg.color: #ff5b1f
osd.button.focused.text.color: #0b0b0c
osd.button.pressed.bg: flat solid
osd.button.pressed.bg.color: #2a2a2f
osd.button.pressed.text.color: #ede9e0
