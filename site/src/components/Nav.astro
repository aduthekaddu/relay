---
/**
 * Top navigation. Server-rendered and usable without JS (the mobile menu
 * falls back to a plain link row); the `nav` island adds the disclosure
 * menu and the scrolled backdrop.
 */
import { NAV, REPO } from '../lib/site'
import { href, isCurrent } from '../lib/url'
import Mark from './Mark.astro'

const path = Astro.url.pathname
---

<header class="nav" data-island="nav" data-open="false">
  <div class="nav-inner wrap">
    <a class="nav-brand" href={href()} aria-label="Relay home">
      <Mark size={22} />
      <span>Relay</span>
    </a>
    <nav class="nav-links" aria-label="Primary" data-menu id="nav-menu">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={href(item.href)} aria-current={isCurrent(path, item.href) ? 'page' : undefined} data-area={item.area} data-astro-reload={item.href.startsWith('docs') ? true : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav-menu-only">
          <a href={REPO}>GitHub</a>
        </li>
      </ul>
    </nav>
    <div class="nav-actions">
      <a class="nav-gh" href={REPO} aria-label="Relay on GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
      </a>
      <a class="btn btn-primary btn-sm" href={href('install/')}>Get Relay</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-menu-toggle>
        <span class="sr-only">Menu</span>
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
