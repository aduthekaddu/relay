---
/**
 * PhoneTerminal — a phone running a Relay terminal session: compact bar,
 * scripted output, the mobile key bar and the compose bar from
 * docs/dev/TERMINAL_UX.md. The markup is the final frame; the
 * `phone-terminal` island renders any point on the script's timeline
 * (scrubbed by scroll on the home page, looped with `autoplay`).
 */
import { KEYS, LINES, SESSION } from '../lib/phone-script'

interface Props {
  id: string
  autoplay?: boolean
  class?: string
}
const { id, autoplay = false, class: cls } = Astro.props
---

<figure class:list={['phone', cls]} id={id} data-island="phone-terminal" data-autoplay={autoplay ? '' : undefined} data-keybar="up">
  <div class="phone-body">
    <div class="phone-screen">
      <div class="phone-status" aria-hidden="true">
        <span class="mono">9:41</span>
        <span class="phone-island"></span>
        <span class="phone-sig"><i></i><i></i><i></i><i></i></span>
      </div>
      <div class="pt-bar" data-part="persist">
        <span class="pt-back" aria-hidden="true">‹</span>
        <span class="pt-title mono"><b>{SESSION.agent}</b> · {SESSION.task}</span>
        <span class="pt-state"><span class="dot dot-ok" data-status></span><span class="sr-only" data-status-label>Running</span></span>
        <span class="pt-more" aria-hidden="true">⋯</span>
      </div>
      <div class="pt-term mono" role="log" aria-label="Terminal output">
        <div class="pt-lines">
          {
            LINES.map((l) => (
              <div class="pt-line" data-line data-t={l.t} data-end={l.end}>
                {l.segs.map(([tone, text]) => (
                  <span class={`t-${tone}`} data-seg>
                    {text}
                  </span>
                ))}
              </div>
            ))
          }
          <div class="pt-cursor" aria-hidden="true"></div>
        </div>
      </div>
      <div class="pt-keys" data-part="keys" aria-hidden="true">
        <div class="pt-keys-row">
          {KEYS.map((k) => <span class:list={['pt-key', { 'pt-key-mod': k === 'ctrl' || k === 'alt' }]}>{k}</span>)}
        </div>
        <span class="pt-swipe"></span>
      </div>
      <div class="pt-compose" data-part="compose" aria-hidden="true">
        <span class="pt-attach" data-part="paste" title="Paste image">
          <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 3h10v10H3z M3 10l3-3 3 3 2-2 2 2" fill="none" stroke="currentColor" stroke-width="1.3"></path></svg>
        </span>
        <span class="pt-field">
          <span class="pt-placeholder" data-compose-placeholder>Message {SESSION.agent}…</span>
          <span class="pt-text" data-compose-text></span>
        </span>
        <span class="pt-mic">
          <svg viewBox="0 0 16 16" width="14" height="14"><path d="M8 2a2 2 0 0 1 2 2v4a2 2 0 0 1-4 0V4a2 2 0 0 1 2-2zM4 8a4 4 0 0 0 8 0M8 12v2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
        </span>
        <span class="pt-send" data-send>⏎</span>
      </div>
      <div class="pt-kbd" aria-hidden="true"></div>
    </div>
  </div>
  <figcaption class="sr-only">
    A phone showing Claude Code running in a Relay terminal: it refactors the auth middleware, runs the tests, asks
    whether to push, and the user answers from the compose bar.
  </figcaption>
</figure>
