---
/** The Relay mark: a dot-matrix "R" whose last dot is the orange beacon. */
interface Props {
  size?: number
  class?: string
}
const { size = 24, class: cls } = Astro.props
const dots = [
  [4, 4], [9, 4], [14, 4], [19, 4], [4, 9], [24, 9], [4, 14], [9, 14], [14, 14], [19, 14], [24, 14], [4, 19], [19, 19], [4, 24],
]
---

<svg class:list={['mark', cls]} viewBox="0 0 28 28" width={size} height={size} aria-hidden="true" focusable="false">
  <g fill="currentColor">{dots.map(([x, y]) => <circle cx={x} cy={y} r="1.7" />)}</g>
  <circle class="mark-beacon" cx="24" cy="24" r="2.6" />
</svg>
