{
  "name": "Relay",
  "short_name": "Relay",
  "description": "Your machine, relayed to every screen.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#0b0b0c",
  "theme_color": "#0b0b0c",
  "orientation": "any",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/badge-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "shortcuts": [
    {
      "name": "New terminal",
      "url": "/terminal?new=1"
    },
    {
      "name": "Agents",
      "url": "/agents"
    },
    {
      "name": "Files",
      "url": "/files"
    }
  ],
  "id": "/",
  "categories": [
    "developer",
    "productivity",
    "utilities"
  ]
}
